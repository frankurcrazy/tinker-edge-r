+#include "rk3399pro-tinker-edge-r.dtsi"
diff --git a/arch/arm64/boot/dts/rockchip/rk3399pro-tinker-edge-r.dtsi b/arch/arm64/boot/dts/rockchip/rk3399pro-tinker-edge-r.dtsi
new file mode 100644
index 000000000..2778a2fb7
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3399pro-tinker-edge-r.dtsi
@@ -0,0 +1,1332 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * ASUS Tinker Edge R (Rockchip RK3399Pro) - board description for the
+ * Rockchip 6.1 vendor kernel.
+ *
+ * Ported from ASUS's Linux 4.4 rk3399pro-tinker_edge_r.dts (board wiring,
+ * regulators, pin usage) using the Toybrick RK3399ProD 6.1 files and the
+ * rk3399pro-evb-v11-linux 6.1 file (Type-C wiring) as templates for the
+ * 6.1 bindings.  See docs/40-kernel-port.md in the tinker-edge-r build
+ * repository for the node-by-node mapping and the reasons behind each choice.
+ *
+ * Hardware summary (ASUS schematic block diagram):
+ *  - RK3399Pro, 4 GB LPDDR4 (CPU side), 2 GB LPDDR3 (NPU side), 16 GB eMMC
+ *  - NPU attached over USB (USB20_NPU + USB30_NPU through a GL3523 hub),
+ *    firmware pushed by userspace at boot (npu_upgrade / upgrade_tool)
+ *  - PCIe x1 -> M.2 Key-E (RTL8822CE Wi-Fi; Bluetooth over USB 2.0)
+ *  - RK809-3 PMIC (I2C0), FAN53555 for VDD_CPU_B (I2C0) and VDD_GPU (I2C8)
+ *  - USB Type-C with FUSB302B (I2C8) on usbdrd3_0 (dual role, SuperSpeed)
+ *  - HDMI, two RPi-style 15-pin CSI-2 connectors (CSI0/I2C1, CSI1/I2C2)
+ *  - RTL8211F gigabit PHY (RGMII, external 125 MHz clock)
+ *  - Debug console: UART0 on the 40-pin header (pins 8/10), 115200 baud
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/pwm/pwm.h>
+#include <dt-bindings/sensor-dev.h>
+#include <dt-bindings/usb/pd.h>
+#include "rk3399pro.dtsi"
+#include "rk3399-linux.dtsi"
+#include "rk3399-opp.dtsi"
+
+/* No U-Boot logo hand-over on this image (see Toybrick prod-linux). */
+/delete-node/ &drm_logo;
+
+/ {
+	model = "ASUS Tinker Edge R";
+	compatible = "asus,tinker-edge-r", "rockchip,rk3399pro-tinker-edge-r",
+		     "rockchip,rk3399pro";
+
+	aliases {
+		mmc0 = &sdhci;	/* eMMC  -> /dev/mmcblk0 */
+		mmc1 = &sdmmc;	/* microSD -> /dev/mmcblk1 */
+		ethernet0 = &gmac;
+	};
+
+	chosen {
+		/* Overridden by the bootloader (extlinux append); kept as a sane default. */
+		bootargs = "earlycon=uart8250,mmio32,0xff180000 console=ttyFIQ0,115200n8 console=tty0 swiotlb=1 coherent_pool=1m";
+	};
+
+	adc-keys {
+		compatible = "adc-keys";
+		io-channels = <&saradc 2>;
+		io-channel-names = "buttons";
+		poll-interval = <100>;
+		keyup-threshold-microvolt = <1800000>;
+
+		esc-key {
+			linux,code = <KEY_ESC>;
+			label = "esc";
+			press-threshold-microvolt = <1310000>;
+		};
+
+		menu-key {
+			linux,code = <KEY_MENU>;
+			label = "menu";
+			press-threshold-microvolt = <987000>;
+		};
+
+		home-key {
+			linux,code = <KEY_HOME>;
+			label = "home";
+			press-threshold-microvolt = <624000>;
+		};
+
+		vol-down-key {
+			linux,code = <KEY_VOLUMEDOWN>;
+			label = "volume down";
+			press-threshold-microvolt = <300000>;
+		};
+
+		vol-up-key {
+			linux,code = <KEY_VOLUMEUP>;
+			label = "volume up";
+			press-threshold-microvolt = <17000>;
+		};
+	};
+
+	clkin_gmac: external-gmac-clock {
+		compatible = "fixed-clock";
+		clock-frequency = <125000000>;
+		clock-output-names = "clkin_gmac";
+		#clock-cells = <0>;
+	};
+
+	/* 27 MHz crystal on the Geekworm X1301 / Auvidea B101 HDMI-RX boards. */
+	tc358743_refclk: tc358743-refclk {
+		compatible = "fixed-clock";
+		clock-frequency = <27000000>;
+		clock-output-names = "tc358743_refclk";
+		#clock-cells = <0>;
+	};
+
+	gpio-leds {
+		compatible = "gpio-leds";
+
+		pwr-led {
+			label = "pwr-led";
+			gpios = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "default-on";
+			retain-state-suspended;
+		};
+
+		act-led {
+			label = "act-led";
+			gpios = <&gpio0 RK_PA3 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "mmc0";
+		};
+
+		rsv-led {
+			label = "rsv-led";
+			gpios = <&gpio0 RK_PB1 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "none";
+		};
+	};
+
+	hdmi_sound: hdmi-sound {
+		status = "okay";
+		compatible = "simple-audio-card";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,mclk-fs = <256>;
+		simple-audio-card,name = "rockchip,hdmi";
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s2>;
+		};
+		simple-audio-card,codec {
+			sound-dai = <&hdmi>;
+		};
+	};
+
+	rk809-sound {
+		status = "okay";
+		compatible = "simple-audio-card";
+		simple-audio-card,format = "i2s";
+		simple-audio-card,name = "rockchip,rk809";
+		simple-audio-card,mclk-fs = <256>;
+		simple-audio-card,widgets =
+			"Microphone", "Mic Jack",
+			"Headphone", "Headphone Jack";
+		simple-audio-card,routing =
+			"Mic Jack", "MICBIAS1",
+			"IN1P", "Mic Jack",
+			"Headphone Jack", "HPOL",
+			"Headphone Jack", "HPOR";
+
+		simple-audio-card,cpu {
+			sound-dai = <&i2s1>;
+		};
+		simple-audio-card,codec {
+			sound-dai = <&rk809_codec>;
+		};
+	};
+
+	rk_headset {
+		compatible = "rockchip_headset";
+		headset_gpio = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&hp_det>;
+		io-channels = <&saradc 3>;
+	};
+
+	sdhci_pwrseq: sdhci-pwrseq {
+		compatible = "mmc-pwrseq-emmc";
+		pinctrl-0 = <&sdhci_reset>;
+		pinctrl-names = "default";
+		reset-gpios = <&gpio2 RK_PA4 GPIO_ACTIVE_HIGH>;
+	};
+
+	/*
+	 * Referenced by rk3399pro.dtsi's sdio0 node.  Nothing sits on SDIO on this
+	 * board (Wi-Fi is PCIe), so the pwrseq and sdio0 stay disabled.
+	 */
+	sdio_pwrseq: sdio-pwrseq {
+		compatible = "mmc-pwrseq-simple";
+		clocks = <&rk809 1>;
+		clock-names = "ext_clock";
+		status = "disabled";
+	};
+
+	vcc_phy: vcc-phy-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_phy";
+		regulator-always-on;
+		regulator-boot-on;
+	};
+
+	vcc5v0_sys: vccsys {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc5v0_sys";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+	};
+
+	/*
+	 * VDD_LOG is a PWM2-driven rail configured by U-Boot; the kernel never
+	 * touches it (same approach as the Toybrick 6.1 port, dmc stays off).
+	 */
+	vdd_log: vdd-log {
+		compatible = "regulator-fixed";
+		regulator-name = "vdd_log";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <900000>;
+		regulator-max-microvolt = <900000>;
+	};
+
+	/* M.2 Key-E WL_REG_ON (GPIO2_D3).  On 4.4 the SDIO pwrseq drove it; here the
+	 * PCIe host enables it before link training via vpcie3v3-supply. */
+	vcc_wifi: vcc-wifi-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_wifi";
+		enable-active-high;
+		gpio = <&gpio2 RK_PD3 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&wifi_enable_h>;
+		regulator-always-on;
+		regulator-boot-on;
+		startup-delay-us = <100000>;
+		vin-supply = <&vcc3v3_sys>;
+	};
+
+	/* M.2 Key-E BT_RST / BT_REG_ON (GPIO2_D4): keep the USB Bluetooth part enabled. */
+	vcc_bt: vcc-bt-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_bt";
+		enable-active-high;
+		gpio = <&gpio2 RK_PD4 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&bt_enable_h>;
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&vcc3v3_sys>;
+	};
+
+	/* Type-C VBUS source switch (VCC5V0_TYPEC0_EN, GPIO4_D1), driven by TCPM. */
+	vbus_typec: vbus-typec-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vbus_typec";
+		enable-active-high;
+		gpio = <&gpio4 RK_PD1 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&vcc5v0_typec0_en>;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		vin-supply = <&vcc5v0_sys>;
+	};
+
+	/* CSI0 connector: 3.3 V camera power switch (GPIO0_B0) and CAM_GPIO/enable (GPIO2_A3). */
+	vcc_csi0: vcc-csi0-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_csi0";
+		enable-active-high;
+		gpio = <&gpio0 RK_PB0 GPIO_ACTIVE_HIGH>;
+		pinctrl-names = "default";
+		pinctrl-0 = <&csi0_pwr_en>;
+		regulator-always-on;
+		regulator-boot-on;
+		startup-delay-us = <20000>;
+		vin-supply = <&vcc3v3_sys>;
+	};
+
+	csi0_enable: csi0-enable-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "csi0_enable";
+		enable-active-high;
+		gpio = <&gpio2 RK_PA3 GPIO_ACTIVE_HIGH>;
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&vcc_csi0>;
+	};
+
+	/* CSI1 connector: camera power (GPIO2_B3) and CAM_GPIO/enable (GPIO2_A2). */
+	vcc_csi1: vcc-csi1-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc_csi1";
+		enable-active-high;
+		gpio = <&gpio2 RK_PB3 GPIO_ACTIVE_HIGH>;
+		regulator-always-on;
+		regulator-boot-on;
+		startup-delay-us = <20000>;
+		vin-supply = <&vcc3v3_sys>;
+	};
+
+	csi1_enable: csi1-enable-regulator {
+		compatible = "regulator-fixed";
+		regulator-name = "csi1_enable";
+		enable-active-high;
+		gpio = <&gpio2 RK_PA2 GPIO_ACTIVE_HIGH>;
+		regulator-always-on;
+		regulator-boot-on;
+		vin-supply = <&vcc_csi1>;
+	};
+};
+
+&cdn_dp {
+	/* DisplayPort over Type-C needs an extcon bridge the TCPM stack does not
+	 * provide in this tree; disabled like the Toybrick port.  HDMI is primary. */
+	status = "disabled";
+	phys = <&tcphy0_dp>;
+};
+
+&cpu_l0 {
+	cpu-supply = <&vdd_cpu_l>;
+};
+
+&cpu_l1 {
+	cpu-supply = <&vdd_cpu_l>;
+};
+
+&cpu_l2 {
+	cpu-supply = <&vdd_cpu_l>;
+};
+
+&cpu_l3 {
+	cpu-supply = <&vdd_cpu_l>;
+};
+
+&cpu_b0 {
+	cpu-supply = <&vdd_cpu_b>;
+};
+
+&cpu_b1 {
+	cpu-supply = <&vdd_cpu_b>;
+};
+
+&display_subsystem {
+	status = "okay";
+	/delete-property/ logo-memory-region;
+};
+
+&route_hdmi {
+	status = "okay";
+	connect = <&vopb_out_hdmi>;
+};
+
+&route_dsi {
+	status = "disabled";
+};
+
+&route_edp {
+	status = "disabled";
+};
+
+&dmc {
+	status = "disabled";
+};
+
+&dp_in_vopb {
+	status = "disabled";
+};
+
+&dsi_in_vopb {
+	status = "disabled";
+};
+
+&emmc_phy {
+	status = "okay";
+};
+
+&fiq_debugger {
+	/* Kernel console on UART0 (40-pin header pins 8/10), 115200 8N1 as on the
+	 * ASUS image.  U-Boot's own console is UART2 (see docs/20-boot-flow.md). */
+	rockchip,serial-id = <0>;
+	rockchip,baudrate = <115200>;
+	rockchip,irq-mode-enable = <1>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart0_xfer>;
+	status = "okay";
+};
+
+&gmac {
+	phy-supply = <&vcc_phy>;
+	phy-mode = "rgmii";
+	clock_in_out = "input";
+	snps,reset-gpio = <&gpio3 RK_PB7 GPIO_ACTIVE_LOW>;
+	snps,reset-active-low;
+	snps,reset-delays-us = <0 16000 72000>;
+	assigned-clocks = <&cru SCLK_RMII_SRC>;
+	assigned-clock-parents = <&clkin_gmac>;
+	pinctrl-names = "default";
+	pinctrl-0 = <&rgmii_pins>;
+	tx_delay = <0x23>;
+	rx_delay = <0x22>;
+	status = "okay";
+};
+
+&gpu {
+	status = "okay";
+	mali-supply = <&vdd_gpu>;
+	interrupt-names = "JOB", "MMU", "GPU";
+};
+
+&hdmi {
+	status = "okay";
+	#sound-dai-cells = <0>;
+	rockchip,phy-table =
+		<74250000  0x8009 0x0004 0x0272>,
+		<165000000 0x802b 0x0004 0x0209>,
+		<297000000 0x8039 0x0005 0x028d>,
+		<594000000 0x8039 0x0000 0x00f6>,
+		<000000000 0x0000 0x0000 0x0000>;
+};
+
+&hdmi_in_vopb {
+	status = "okay";
+};
+
+&hdmi_in_vopl {
+	status = "disabled";
+};
+
+&i2c0 {
+	status = "okay";
+	i2c-scl-rising-time-ns = <180>;
+	i2c-scl-falling-time-ns = <30>;
+	clock-frequency = <400000>;
+
+	rk809: pmic@20 {
+		compatible = "rockchip,rk809";
+		reg = <0x20>;
+		interrupt-parent = <&gpio1>;
+		interrupts = <RK_PC2 IRQ_TYPE_LEVEL_LOW>;
+		pinctrl-names = "default", "pmic-sleep",
+				"pmic-power-off", "pmic-reset";
+		pinctrl-0 = <&pmic_int_l>;
+		pinctrl-1 = <&soc_slppin_slp>, <&rk809_slppin_slp>;
+		pinctrl-2 = <&soc_slppin_gpio>, <&rk809_slppin_pwrdn>;
+		pinctrl-3 = <&soc_slppin_gpio>, <&rk809_slppin_null>;
+		rockchip,system-power-controller;
+		pmic-reset-func = <0>;
+		wakeup-source;
+		#clock-cells = <1>;
+		clock-output-names = "rk808-clkout1", "rk808-clkout2";
+
+		vcc1-supply = <&vcc5v0_sys>;
+		vcc2-supply = <&vcc5v0_sys>;
+		vcc3-supply = <&vcc5v0_sys>;
+		vcc4-supply = <&vcc5v0_sys>;
