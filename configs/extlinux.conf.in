# U-Boot distro-boot menu (sysboot / extlinux) for the Tinker Edge R.
# Generated by scripts/stage-image.sh; edit /boot/extlinux/extlinux.conf on the
# device to change the default entry or the kernel command line.
#
# Variables substituted at image build time:
#   @KERNEL_RELEASE@ @DEFAULT_DTB@ @CMDLINE@ @ROOT_PARTUUID@

default tinker-edge-r
timeout 30
menu title ASUS Tinker Edge R - Ubuntu 22.04 (Linux @KERNEL_RELEASE@)

label tinker-edge-r
    menu label Ubuntu 22.04 (HDMI-RX on CSI0)
    kernel /Image
    fdt /dtbs/@DEFAULT_DTB@
    append root=PARTUUID=@ROOT_PARTUUID@ @CMDLINE@

label hdmirx-csi1
    menu label Ubuntu 22.04 (HDMI-RX board on CSI1)
    kernel /Image
    fdt /dtbs/rk3399pro-tinker-edge-r-hdmirx-csi1.dtb
    append root=PARTUUID=@ROOT_PARTUUID@ @CMDLINE@

label rescue
    menu label Ubuntu 22.04 (single user, no NPU/gadget services)
    kernel /Image
    fdt /dtbs/@DEFAULT_DTB@
    append root=PARTUUID=@ROOT_PARTUUID@ @CMDLINE@ systemd.unit=rescue.target
