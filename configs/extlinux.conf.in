# U-Boot distro-boot menu (sysboot / extlinux) for the Tinker Edge R.
# Generated by scripts/stage-image.sh.  The U-Boot console is not wired out on
# this board, so the menu cannot be used: change "default" to boot another entry.

default tinker-edge-r
timeout 30
menu title ASUS Tinker Edge R - Ubuntu 22.04 (Linux @KERNEL_RELEASE@)

label tinker-edge-r
    menu label Ubuntu 22.04
    kernel /Image
    fdt /dtbs/@DEFAULT_DTB@
    append root=PARTUUID=@ROOT_PARTUUID@ @CMDLINE@

label hdmirx-csi0
    menu label Ubuntu 22.04 (X1301 HDMI-RX board on CSI0)
    kernel /Image
    fdt /dtbs/rk3399pro-tinker-edge-r-hdmirx-csi0.dtb
    append root=PARTUUID=@ROOT_PARTUUID@ @CMDLINE@

label hdmirx-csi1
    menu label Ubuntu 22.04 (X1301 HDMI-RX board on CSI1)
    kernel /Image
    fdt /dtbs/rk3399pro-tinker-edge-r-hdmirx-csi1.dtb
    append root=PARTUUID=@ROOT_PARTUUID@ @CMDLINE@

label rescue
    menu label Ubuntu 22.04 (single user, no NPU/gadget services)
    kernel /Image
    fdt /dtbs/@DEFAULT_DTB@
    append root=PARTUUID=@ROOT_PARTUUID@ @CMDLINE@ systemd.unit=rescue.target systemd.mask=usb-gadget.service
