# Board / build configuration for the Tinker Edge R Ubuntu 22.04 image.
# Sourced by scripts/lib.sh.  Every value can be overridden from the environment,
# e.g.  J=8 ROOTFS_USER=frank ./build.sh all
#
# shellcheck shell=bash

BOARD="${BOARD:-tinker-edge-r}"
IMAGE_NAME="${IMAGE_NAME:-tinker-edge-r-ubuntu-22.04}"

# ---- toolchain (inside the builder container) --------------------------------
CROSS_COMPILE="${CROSS_COMPILE:-aarch64-linux-gnu-}"
# GCC major version for the legacy 2017.09 U-Boot tree (9, 10 or 11 are installed).
UBOOT_GCC_VERSION="${UBOOT_GCC_VERSION:-11}"
J="${J:-$(nproc)}"

# ---- kernel --------------------------------------------------------------------
KERNEL_DEFCONFIG="${KERNEL_DEFCONFIG:-rockchip_linux_defconfig}"
# Config fragments from configs/kernel/, merged on top of the defconfig in order.
KERNEL_FRAGMENTS="${KERNEL_FRAGMENTS:-tinker-edge-r.config usb-gadget-typec.config media-hdmi-rx.config}"
# DTBs to build and ship on the boot partition (relative to arch/arm64/boot/dts/).
KERNEL_DTBS="${KERNEL_DTBS:-rockchip/rk3399pro-tinker-edge-r.dtb rockchip/rk3399pro-tinker-edge-r-hdmirx-csi1.dtb}"
KERNEL_DEFAULT_DTB="${KERNEL_DEFAULT_DTB:-rk3399pro-tinker-edge-r.dtb}"
KERNEL_LOCALVERSION="${KERNEL_LOCALVERSION:--tinker-edge-r}"

# ---- U-Boot ---------------------------------------------------------------------
UBOOT_DEFCONFIG="${UBOOT_DEFCONFIG:-tinker_edge_r_defconfig}"
# rkbin blobs (relative to src/rkbin).  Versions pinned by the rkbin commit in default.xml.
RKBIN_DDR="${RKBIN_DDR:-bin/rk33/rk3399pro_ddr_800MHz_v1.30.bin}"
RKBIN_MINILOADER="${RKBIN_MINILOADER:-bin/rk33/rk3399pro_miniloader_v1.26.bin}"
RKBIN_LOADER_INI="${RKBIN_LOADER_INI:-RKBOOT/RK3399PROMINIALL.ini}"
RKBIN_TRUST_INI="${RKBIN_TRUST_INI:-RKTRUST/RK3399PROTRUST.ini}"

# ---- rootfs ---------------------------------------------------------------------
ROOTFS_SUITE="${ROOTFS_SUITE:-jammy}"
ROOTFS_ARCH="${ROOTFS_ARCH:-arm64}"
ROOTFS_MIRROR="${ROOTFS_MIRROR:-http://ports.ubuntu.com/ubuntu-ports}"
ROOTFS_HOSTNAME="${ROOTFS_HOSTNAME:-tinker-edge-r}"
ROOTFS_USER="${ROOTFS_USER:-tinker}"
ROOTFS_PASSWORD="${ROOTFS_PASSWORD:-tinker}"
ROOTFS_TIMEZONE="${ROOTFS_TIMEZONE:-Etc/UTC}"
ROOTFS_LOCALE="${ROOTFS_LOCALE:-C.UTF-8}"
# Extra apt packages (space separated) on top of src/rootfs/config/packages*.txt
ROOTFS_EXTRA_PACKAGES="${ROOTFS_EXTRA_PACKAGES:-}"

# ---- disk image -----------------------------------------------------------------
# Rockchip RK3399 raw layout (512-byte sectors): idbloader @64, uboot @16384, trust @24576.
IMG_SECTOR_UBOOT=16384
IMG_SECTOR_TRUST=24576
IMG_SECTOR_MISC=32768
IMG_SECTOR_BOOT=40960
IMG_BOOT_SIZE_MB="${IMG_BOOT_SIZE_MB:-256}"
# 0 = size the rootfs partition from its contents plus IMG_ROOTFS_MARGIN_MB.
IMG_ROOTFS_SIZE_MB="${IMG_ROOTFS_SIZE_MB:-0}"
IMG_ROOTFS_MARGIN_MB="${IMG_ROOTFS_MARGIN_MB:-512}"
IMG_COMPRESS="${IMG_COMPRESS:-xz}"   # xz | zstd | none

# Kernel command line (extlinux append).  root= is added by the image stage.
KERNEL_CMDLINE="${KERNEL_CMDLINE:-earlycon=uart8250,mmio32,0xff180000 console=ttyFIQ0,115200n8 console=tty0 rw rootwait rootfstype=ext4 swiotlb=1 coherent_pool=1m cgroup_enable=memory}"
