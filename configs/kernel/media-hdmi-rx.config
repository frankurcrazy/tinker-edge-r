# Camera / HDMI-RX capture: Geekworm X1301 (Toshiba TC358743 HDMI -> MIPI CSI-2)
# on the Raspberry-Pi-style CSI connectors, captured through the RK3399 ISP.
#
# The Rockchip vendor tree pairs its own tc35874x driver (supports TC358743 and
# TC358749, implements the rkmodule ioctls the vendor rkisp1 driver expects) with
# the vendor "rockchip,rk3399-rkisp1" ISP driver.  The upstream tc358743 driver
# claims the same compatible string, so exactly one of them may be enabled.

CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_CONTROLLER=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2_SUBDEV_API=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_V4L_MEM2MEM_DRIVERS=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_VIDEOBUF2_DMA_SG=y
CONFIG_VIDEOBUF2_VMALLOC=y

# Rockchip ISP v1 (vendor driver, node rkisp1_0 / rkisp1_1) + MIPI D-PHY RX
CONFIG_VIDEO_ROCKCHIP_RKISP1=y
CONFIG_VIDEO_ROCKCHIP_ISP=y
CONFIG_PHY_ROCKCHIP_MIPI_RX=y
CONFIG_PHY_ROCKCHIP_CSI2_DPHY=y
CONFIG_VIDEO_ROCKCHIP_RGA=y

# TC358743 / TC358749 HDMI to CSI-2 bridge (vendor driver) - keep upstream one off
CONFIG_VIDEO_TC35874X=y
# CONFIG_VIDEO_TC358743 is not set

# Raspberry Pi camera modules that fit the same connectors (optional, modules)
CONFIG_VIDEO_IMX219=m
CONFIG_VIDEO_OV5647=m

# Generic V4L2 userspace helpers
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_V4L2_I2C=y
CONFIG_CEC_CORE=y
CONFIG_CEC_NOTIFIER=y
CONFIG_MEDIA_CEC_SUPPORT=y
