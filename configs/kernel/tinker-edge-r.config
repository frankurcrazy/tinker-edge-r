# Board fragment for the ASUS Tinker Edge R on the Rockchip 6.1 vendor kernel.
# Merged on top of rockchip_linux_defconfig (Toybrick RK3399ProD) by scripts/stage-kernel.sh.

# The Toybrick defconfig links Realtek 8723D blobs into the kernel from firmware/,
# but the .bin files are not part of the git tree (build fails from a clean clone).
# Firmware comes from the rootfs (/lib/firmware) instead.
CONFIG_EXTRA_FIRMWARE=""
CONFIG_EXTRA_FIRMWARE_DIR=""

# --- Wi-Fi / Bluetooth: M.2 Key-E Realtek RTL8822CE (PCIe Wi-Fi + USB Bluetooth)
CONFIG_RTW88=y
CONFIG_RTW88_PCI=y
CONFIG_RTW88_8822C=y
CONFIG_RTW88_8822CE=y
CONFIG_RTW88_8822CU=y
CONFIG_RTW88_8723DU=y
CONFIG_RTW88_DEBUGFS=y
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_BNEP=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_HCIBTUSB_BCM=y
CONFIG_BT_HCIBTUSB_RTL=y
CONFIG_BT_RTL=y
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211_LEDS=y

# --- PCIe (M.2 slot) already on; make sure the host driver is built in
CONFIG_PCIE_ROCKCHIP_HOST=y
CONFIG_PHY_ROCKCHIP_PCIE=y

# --- on-board sensors / EEPROM on I2C1 (upstream drivers, as modules)
CONFIG_IIO=y
CONFIG_INV_MPU6050_IIO=m
CONFIG_INV_MPU6050_I2C=m
CONFIG_AK8975=m
CONFIG_EEPROM_AT24=m

# --- misc board bits
CONFIG_KEYBOARD_ADC=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y
CONFIG_LEDS_TRIGGER_DEFAULT_ON=y
CONFIG_LEDS_TRIGGER_MMC=y
CONFIG_LEDS_TRIGGER_NETDEV=y
CONFIG_MMC_PWRSEQ_EMMC=y
CONFIG_MMC_PWRSEQ_SIMPLE=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_FAN53555=y
CONFIG_REGULATOR_PWM=y
CONFIG_SENSORS_GPIO_FAN=y
CONFIG_RK_HEADSET=y

# --- what the NPU userspace (npu_powerctrl / npu_upgrade) relies on
CONFIG_GPIO_SYSFS=y
CONFIG_DEBUG_FS=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD_PLATFORM=y

# --- Ubuntu 22.04 userspace niceties
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_HUGETLB=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_CGROUP_NET_CLASSID=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_BTRFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NLS_UTF8=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_MACVLAN=m
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_KALLSYMS=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_USER_API_AEAD=y
CONFIG_CRYPTO_USER_API_RNG=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_ROCKCHIP=y
CONFIG_I2C_CHARDEV=y
CONFIG_SPI_SPIDEV=m
CONFIG_PWM_ROCKCHIP=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_NET_RNDIS_HOST=m
CONFIG_USB_NET_AX8817X=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_USB_RTL8152=m
CONFIG_USB_WDM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_SERIAL_OPTION=m
CONFIG_USB_SERIAL_WWAN=m
CONFIG_USB_ACM=m
